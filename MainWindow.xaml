<Window x:Class="OntoScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:OntoScope.Controls"
        mc:Ignorable="d"
        Title="OntoScope — просмотр онтологий"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#30394A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="27" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#111824" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid Width="25" Height="25">
                        <Ellipse Width="8" Height="8" Fill="#A394FF" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Ellipse Width="8" Height="8" Fill="#7364D7" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Ellipse Width="8" Height="8" Fill="#65B9B3" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Path Data="M6,5 L18,5 M8,8 L12,18 M17,8 L13,18" Stroke="#8C7FE9" StrokeThickness="1.4" />
                    </Grid>
                    <TextBlock Text="OntoScope" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                    <Border Background="#253043" CornerRadius="4" Padding="5,2" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BETA" FontSize="8" FontWeight="SemiBold" Foreground="#9AA7BA" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DimBrush}">
                    <Run Text="Просмотр онтологий" />
                    <Run Text="  /  " Foreground="#3E4A5E" />
                    <Run Text="{Binding OntologyName, Mode=OneWay}" Foreground="#8794A9" />
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="Свернуть">
                        <Path Data="M15,21 L25,21" Stroke="#8592A6" StrokeThickness="1.3" Stretch="None" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" ToolTip="Развернуть">
                        <Path Data="M15,14 L25,14 L25,24 L15,24 Z" Stroke="#8592A6" StrokeThickness="1.2" Stretch="None" Fill="Transparent" />
                    </Button>
                    <Button Style="{StaticResource WindowButtonStyle}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="M15,14 L25,24 M25,14 L15,24" Stroke="#8592A6" StrokeThickness="1.3" Stretch="None" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="#141C29">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button x:Name="OpenButton" Style="{StaticResource AccentButtonStyle}" Click="OpenFile_Click" ToolTip="Открыть OWL-файл (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,6 L2,4 L8,4 L10,6 L18,6 L18,16 L2,16 Z M2,8 L18,8"
                                  Stroke="White" StrokeThickness="1.4" Fill="Transparent" Stretch="Uniform" Width="18" Height="18" />
                            <TextBlock Text="Открыть OWL" Foreground="White" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="25" Background="{StaticResource BorderBrush}" Margin="18,0" />
                    <TextBlock Text="Библиотека" FontSize="12" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                    <Path Data="M4,7 L7,10 L10,7" Stroke="#536178" StrokeThickness="1.2" Width="12" Height="12" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OntologyName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="#172D2C" BorderBrush="#28504A" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#65C7B9" Margin="0,0,6,0" />
                            <TextBlock Text="OWL 2" FontSize="10" FontWeight="SemiBold" Foreground="#79CFC3" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="RDF / XML" Foreground="{StaticResource DimBrush}" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0">
                    <Grid Margin="15,18,15,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M3,3 L9,3 L9,9 L3,9 Z M13,3 L19,3 L19,9 L13,9 Z M3,13 L9,13 L9,19 L3,19 Z M13,13 L19,13 L19,19 L13,19 Z"
                                  Stroke="#8F7FEA" StrokeThickness="1.3" Width="17" Height="17" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Проводник" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="1" Height="37" Background="#0F1622" BorderBrush="#303A4D" BorderThickness="1" CornerRadius="7">
                            <Grid Margin="11,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="M9,9 A5,5 0 1,1 8,8 M13,13 L18,18" Stroke="#6F7D93" StrokeThickness="1.4" Fill="Transparent"
                                      Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0" ToolTip="Поиск по имени или IRI (Ctrl+F)" />
                                <TextBlock Grid.Column="1" Text="Найти класс..." Foreground="#59677B" FontSize="11" Margin="8,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="2" Background="#222B3A" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl F" FontSize="9" Foreground="#68758A" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="3,22,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ИЕРАРХИЯ КЛАССОВ" Style="{StaticResource SectionLabelStyle}" Margin="0" />
                                <Border Background="#242D3D" CornerRadius="4" Padding="5,1" Margin="7,0,0,0">
                                    <TextBlock Text="{Binding ClassCount}" FontSize="9" Foreground="#94A1B5" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding ExpandAllCommand}" Padding="3" Margin="0" ToolTip="Развернуть все">
                                    <Path Data="M4,3 L10,9 M10,3 L10,9 L4,9 M14,3 L20,9 M20,3 L20,9 L14,9"
                                          Stroke="#738197" StrokeThickness="1.1" Width="15" Height="15" />
                                </Button>
                                <Button Command="{Binding CollapseAllCommand}" Padding="3" Margin="2,0,0,0" ToolTip="Свернуть все">
                                    <Path Data="M4,3 L10,9 M4,3 L10,3 M14,9 L20,3 M14,3 L20,3"
                                          Stroke="#738197" StrokeThickness="1.1" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Height="1" Background="#222C3C" Margin="0,0,0,8" />

                        <Grid Grid.Row="4">
                            <ListBox ItemsSource="{Binding VisibleClasses}" SelectedItem="{Binding SelectedClassItem, Mode=TwoWay}"
                                     VirtualizingPanel.IsVirtualizing="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{Binding Indent}" ToolTip="{Binding Node.Uri}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="17" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Padding="0" Margin="0" Width="15" Height="19"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="›" FontSize="15" Foreground="#68778D" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="90" />
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value><RotateTransform Angle="0" /></Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Border Grid.Column="1" Width="6" Height="6" CornerRadius="2" Background="#8373DF"
                                                    VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Node.Name}" FontSize="11.5" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VisibleClasses.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Ничего не найдено" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Измените поисковый запрос" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="5" Background="#171F2D" BorderBrush="#2B3547" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="34" Background="#242D42" CornerRadius="6">
                                    <Path Data="M7,3 L15,3 L20,8 L20,25 L7,25 Z M15,3 L15,8 L20,8 M10,13 L17,13 M10,17 L17,17"
                                          Stroke="#9384EA" StrokeThickness="1.2" Fill="Transparent" Width="20" Height="24" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="9.5" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="89" />
                        <RowDefinition Height="51" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#111925" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                        <Grid Margin="24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OntologyName}" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="Карта классов и семантических отношений" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="{Binding ClassCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="классов" FontSize="9.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Width="1" Height="30" Background="#2A3546" />
                                <StackPanel Margin="18,0">
                                    <TextBlock Text="{Binding PropertyCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="свойств" FontSize="9.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Width="1" Height="30" Background="#2A3546" />
                                <StackPanel Margin="18,0,0,0">
                                    <TextBlock Text="{Binding IndividualCount}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="экземпляров" FontSize="9.5" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="#121A26" Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GraphTabStyle}" Command="{Binding ShowGraphCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,4 A2,2 0 1,1 3,3 M16,4 A2,2 0 1,1 15,3 M10,16 A2,2 0 1,1 9,15 M5,6 L9,14 M15,6 L11,14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="16" Height="16" />
                                    <TextBlock Text="Граф" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TableTabStyle}" Command="{Binding ShowTableCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,3 L17,3 L17,17 L3,17 Z M3,8 L17,8 M3,13 L17,13 M9,8 L9,17"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Width="16" Height="16" />
                                    <TextBlock Text="Список классов" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsGraphVisible, Converter={StaticResource BoolToVisibility}}">
                            <Button Click="ZoomOut_Click" Padding="7,4" ToolTip="Уменьшить">
                                <Path Data="M4,9 L14,9" Stroke="#8794A8" StrokeThickness="1.3" Width="16" Height="16" />
                            </Button>
                            <TextBlock Text="{Binding ZoomPercent, ElementName=Graph, StringFormat={}{0}%}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                       Width="43" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Click="ZoomIn_Click" Padding="7,4" ToolTip="Увеличить">
                                <Path Data="M4,9 L14,9 M9,4 L9,14" Stroke="#8794A8" StrokeThickness="1.3" Width="16" Height="16" />
                            </Button>
                            <Border Width="1" Height="19" Background="#2B3546" Margin="7,0" />
                            <Button Click="FitGraph_Click" ToolTip="Показать весь граф (Ctrl+0)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,7 L3,3 L7,3 M13,3 L17,3 L17,7 M17,13 L17,17 L13,17 M7,17 L3,17 L3,13"
                                          Stroke="#8794A8" StrokeThickness="1.2" Width="16" Height="16" />
                                    <TextBlock Text="По размеру" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <controls:OntologyGraph x:Name="Graph" Visibility="{Binding IsGraphVisible, Converter={StaticResource BoolToVisibility}}" />

                        <DataGrid ItemsSource="{Binding FilteredNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" IsReadOnly="True"
                                  Visibility="{Binding IsTableVisible, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="КЛАСС" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="ИДЕНТИФИКАТОР" Binding="{Binding Id}" Width="*" />
                                <DataGridHyperlinkColumn Header="IRI" Binding="{Binding Uri}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,18"
                                Background="#E0161E2B" BorderBrush="#354052" BorderThickness="1" CornerRadius="7" Padding="11,8"
                                IsHitTestVisible="False" Visibility="{Binding IsGraphVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#8D7CE9" VerticalAlignment="Center" />
                                <TextBlock Text="Класс" FontSize="9.5" Foreground="#98A5B8" Margin="5,0,12,0" VerticalAlignment="Center" />
                                <Line X1="0" Y1="0" X2="17" Y2="0" Stroke="#64718A" StrokeThickness="1.4" VerticalAlignment="Center" />
                                <TextBlock Text="наследование" FontSize="9.5" Foreground="#98A5B8" Margin="5,0,12,0" VerticalAlignment="Center" />
                                <Line X1="0" Y1="0" X2="17" Y2="0" Stroke="#58A5A2" StrokeThickness="1.2" StrokeDashArray="3,2" VerticalAlignment="Center" />
                                <TextBlock Text="связь" FontSize="9.5" Foreground="#98A5B8" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Background="#C0161E2B"
                                CornerRadius="5" Padding="9,6" IsHitTestVisible="False"
                                Visibility="{Binding IsGraphVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Колесо — масштаб  ·  Перетаскивание — навигация" FontSize="9" Foreground="#68768B" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="21,20,21,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ДЕТАЛИ КЛАССА" Style="{StaticResource SectionLabelStyle}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="CopyIri_Click" Padding="4" Margin="0" ToolTip="Скопировать IRI">
                                    <Path Data="M7,7 L7,3 L17,3 L17,13 L13,13 M3,7 L13,7 L13,17 L3,17 Z"
                                          Stroke="#7D8BA0" StrokeThickness="1.2" Fill="Transparent" Width="16" Height="16" />
                                </Button>
                            </Grid>

                            <Border Height="1" Background="#283244" Margin="0,14,0,20" />

                            <Border Width="44" Height="44" Background="#302B4C" BorderBrush="#51466F" BorderThickness="1" CornerRadius="11" HorizontalAlignment="Left">
                                <Grid Width="25" Height="25">
                                    <Ellipse Width="7" Height="7" Fill="#A494F5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Ellipse Width="7" Height="7" Fill="#8170D9" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Ellipse Width="7" Height="7" Fill="#70B9B3" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                                    <Path Data="M5,5 L18,5 M6,8 L11,18 M18,8 L14,18" Stroke="#A392EF" StrokeThickness="1.2" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,15,0,6" />
                            <TextBlock Text="{Binding SelectedUri}" FontSize="10" Foreground="#8D80CE" TextWrapping="Wrap" LineHeight="16" />

                            <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource SectionLabelStyle}" Margin="0,25,0,8" />
                            <TextBlock Text="{Binding SelectedDescription}" FontSize="11.5" Foreground="#A1ADBE" TextWrapping="Wrap" LineHeight="19" />

                            <StackPanel Visibility="{Binding HasParents, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="РОДИТЕЛЬСКИЙ КЛАСС" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8" />
                                <Border Background="#202A3A" BorderBrush="#354156" BorderThickness="1" CornerRadius="6" Padding="9,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4,10 L10,4 L16,10 M10,4 L10,16" Stroke="#8C7DE4" StrokeThickness="1.2" Width="14" Height="14" />
                                        <TextBlock Text="{Binding ParentNames}" FontSize="10.5" Foreground="#B7ADF0" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="ИСХОДЯЩИЕ СВЯЗИ" Style="{StaticResource SectionLabelStyle}" Margin="0,25,0,9" />
                            <ItemsControl ItemsSource="{Binding SelectedRelations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#171F2C" BorderBrush="#2A3547" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Kind}" FontSize="8.5" Foreground="#66758B" />
                                                <TextBlock Text="{Binding Relation}" FontSize="10" Foreground="#8F82D5" Margin="0,4,0,3" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="→" FontSize="12" Foreground="#64748A" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Target}" FontSize="11" Foreground="#D4DAE5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="У этого класса нет исходящих связей" FontSize="10.5" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRelations}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="ПРОСТРАНСТВО ИМЁН" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8" />
                            <Border Background="#101722" CornerRadius="6" Padding="10">
                                <TextBlock Text="{Binding Namespace}" FontFamily="Consolas" FontSize="9.5" Foreground="#7F8CA1" TextWrapping="Wrap" LineHeight="15" />
                            </Border>

                            <Button Click="CopyIri_Click" BorderBrush="#3A4356" BorderThickness="1" Margin="0,22,0,0" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M7,7 L7,3 L17,3 L17,13 L13,13 M3,7 L13,7 L13,17 L3,17 Z"
                                          Stroke="#8D9AAF" StrokeThickness="1.2" Fill="Transparent" Width="14" Height="14" />
                                    <TextBlock Text="Скопировать IRI" FontSize="10.5" Foreground="#A4B0C1" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#101722" BorderBrush="#273143" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Fill="#5EB9A9" />
                        <TextBlock Text="{Binding StatusText}" FontSize="9.5" Foreground="#78869A" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RelationCount, StringFormat={}{0} отношений}" FontSize="9" Foreground="#5F6D81" Margin="0,0,15,0" />
                        <TextBlock Text="C#  ·  WPF" FontSize="9" Foreground="#5F6D81" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
